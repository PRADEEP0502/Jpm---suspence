# Copy this file to .env and fill in your own details. Never commit .env.

# MongoDB connection string (MongoDB Atlas: Connect -> Drivers -> Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=jpm_suspense

# Optional
# PORT=3000
# APP_TIMEZONE=Asia/Kolkata
# SEED_SAMPLE_DATA=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin@123
# SESSION_HOURS=12
# COOKIE_SECURE=false
# BACKUP_KEEP_DAYS=30
# AUTO_BACKUP=true
